# ─── NXTLI GEO Scan — environment variables ───────────────────────────────
# Copy to .env.local for local dev. Set the same vars in your Vercel project.
# Everything here is server-side only EXCEPT the NEXT_PUBLIC_* vars.

# ── Supabase (lead + scan storage) ────────────────────────────────────────
# Without these the scan still works end-to-end, but nothing is persisted.
# The Vercel↔Supabase integration sets these automatically in your Vercel
# project (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, POSTGRES_URL*, …).
SUPABASE_URL=
# Service-role key — SERVER ONLY. Never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public URL/anon key, only if you add client-side reads later.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-shot schema migration via /api/geo/migrate (runs the DB schema using the
# Postgres connection the Vercel↔Supabase integration injects). Set to any
# random string to ENABLE the route; unset it again afterwards to DISABLE it.
MIGRATE_SECRET=
# The route auto-detects the connection string from these (set by Vercel):
# POSTGRES_URL / POSTGRES_PRISMA_URL / DATABASE_URL / SUPABASE_DB_URL / POSTGRES_URL_NON_POOLING

# Config diagnostics via /api/geo/diag (reports provider, key presence, and
# whether the geo-page-checker skill is found). Set to enable; unset to disable.
GEO_DIAG_SECRET=

# ── AI analysis engine ────────────────────────────────────────────────────
# Provider selection. Leave unset to auto-pick: claude → mock.
# The "claude" provider runs the geo-page-checker methodology one-shot (the
# rubric lives in lib/geo/analysis/prompt.ts; skill source in skills/).
#   claude | mock | geo-skill (geo-skill = invoke the interactive skill via
#   container.skills; NOT auto-selected — explicit override only)
# GEO_ANALYSIS_PROVIDER=

# Required for the claude (and geo-skill) provider. SERVER ONLY.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6 — fast, fits the timeout)
# GEO_ANALYSIS_MODEL=claude-sonnet-4-6

# Multi-LLM visibility probe: asks the REAL LLMs what they return about the
# business by name and shows each answer in the report's "Wat AI over je zegt"
# table. Each engine runs ONLY when its key below is set, is time-boxed, and is
# best-effort (a slow/broken engine never blocks the scan). Each configured
# engine adds one API call per scan (extra cost). Set to "off" to disable ALL of
# them at once.
# GEO_AI_SEARCH=off
#
# Per-engine API keys (SERVER ONLY). Leave any unset to skip that engine.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
# (Claude uses ANTHROPIC_API_KEY above.)
#
# Optional model overrides for the probe (defaults shown):
# GEO_OPENAI_MODEL=gpt-4o-mini
# GEO_GEMINI_MODEL=gemini-2.5-flash
# GEO_PERPLEXITY_MODEL=sonar
# (Claude uses GEO_ANALYSIS_MODEL above.)

# Abuse protection: optional global cap on completed scans per rolling 24h
# (credit backstop). Unset = no cap. One-scan-per-email is always enforced when
# Supabase is configured.
# GEO_MAX_SCANS_PER_DAY=100

# Shared NXTLI org Claude skill (the "geo-skill" provider). NOT auto-selected —
# the auto order is claude → mock; use GEO_ANALYSIS_PROVIDER=geo-skill to force it.
# The skill is resolved by name; override the id to skip the lookup.
# GEO_SKILL_NAME=geo-page-checker
# GEO_SKILL_ID=
# GEO_SKILL_VERSION=latest

# ── Email (report delivery) ───────────────────────────────────────────────
# Default adapter is Resend (https://resend.com). Without these the report is
# prepared but not sent. SERVER ONLY.
RESEND_API_KEY=
GEO_EMAIL_FROM="NXTLI <charlie@geo.nxtli.com>"

# ── PDF (optional) ────────────────────────────────────────────────────────
# none (default) serves an HTML report. See lib/geo/report/pdf.ts to wire a
# real generator (playwright | service).
# GEO_PDF_STRATEGY=none

# ── Slack notification (new-lead ping) ────────────────────────────────────
# Slack Incoming Webhook URL. Posts a message on every scan submission.
# Without it, Slack notifications are simply skipped. SERVER ONLY.
# Create: Slack → Apps → "Incoming Webhooks" → Add to a channel → copy URL.
SLACK_WEBHOOK_URL=

# ── HubSpot (lead → CRM) ──────────────────────────────────────────────────
# Private App token (HubSpot → Settings → Integrations → Private Apps → Create,
# scope: crm.objects.contacts.write). Each scan upserts the lead as a HubSpot
# contact (by e-mail — no duplicates). Without it, HubSpot sync is skipped.
# SERVER ONLY.
HUBSPOT_TOKEN=
# The sync also writes three GEO-specific CUSTOM contact properties — create them
# once in HubSpot → Settings → Properties → Contact (exact internal names):
#   geoscore          (Number)            — the AI Visibility Score
#   geoscore_rapport  (Single-line text)  — link to the report
#   geoscanpagina     (Single-line text)  — the scanned URL
# If a property is missing, the lead still syncs with the standard fields only.

# Public base URL of the site, used to build absolute report links in Slack
# and email. Falls back to the request host if unset.
NEXT_PUBLIC_SITE_URL=https://geo.nxtli.com

# ── Admin dashboard (/admin) ──────────────────────────────────────────────
# HTTP Basic Auth for the hidden /admin overview (submissions + credit/€ cost).
# If unset, /admin is locked (503). SERVER ONLY.
# Set a STRONG, UNIQUE password in your real env — never ship these placeholders.
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
# USD→EUR rate for cost display (default 0.92).
# ADMIN_EUR_PER_USD=0.92

# ── CTA links (safe to expose) ────────────────────────────────────────────
# Where the "Plan een sessie" / contact buttons point (chat, report, email).
NEXT_PUBLIC_GEO_STRATEGY_CALL_URL=https://nxtli.com/michiel-schoonhoven-agenda/
# Used in the report + email "plan a session" link (server-side).
GEO_STRATEGY_CALL_URL=https://nxtli.com/michiel-schoonhoven-agenda/

# Charlie's avatar photo. Either commit public/charlie.jpg, OR point this at any
# hosted image URL (no commit needed). Falls back to a "C" monogram if unset.
# NEXT_PUBLIC_CHARLIE_AVATAR_URL=

# ══════════════════════════════════════════════════════════════════════════
# Adverteren op de Radio — Prospect Finder & Scorer  (/radio)
# ══════════════════════════════════════════════════════════════════════════
# Interne prospecting-tool. Zit achter dezelfde Basic Auth als /admin
# (ADMIN_USERNAME / ADMIN_PASSWORD hierboven) — zie proxy.ts.
# In productie is /radio geblokkeerd zonder die credentials; lokaal
# (npm run dev) mag het door met een waarschuwing in de log.

# ── Opslag ────────────────────────────────────────────────────────────────
# "file"     = JSON-bestand op schijf (default zonder database, nul config).
# "postgres" = tabel radio_prospects in dezelfde Supabase-database als GEO.
# Niet gezet: postgres als er een POSTGRES_URL/DATABASE_URL is, anders file.
# RADIO_STORE_DRIVER=file

# Pad van het JSON-bestand voor de file-driver (relatief t.o.v. de projectroot).
# RADIO_DATA_FILE=.data/radio-prospects.json

# ── Research-provider ─────────────────────────────────────────────────────
# "claude"    = AI-analyse van de opgehaalde publieke paginatekst (aanbevolen).
# "heuristic" = trefwoordanalyse, zonder AI. Werkt altijd, beoordeelt grover en
#               komt bewust niet hoger dan fit 69 / Tier B.
# Niet gezet: claude als ANTHROPIC_API_KEY bestaat, anders heuristic.
# RADIO_RESEARCH_PROVIDER=claude

# Model voor de research. Default: claude-sonnet-5. Zet dit als jouw key een
# ander model heeft (bijv. claude-sonnet-4-6) — anders valt de research terug
# op de heuristiek en zie je dat als waarschuwing in de UI.
# RADIO_RESEARCH_MODEL=claude-sonnet-5

# Hoeveel bedrijven tegelijk in een batch (default 3, max 10). Hoger = sneller,
# maar meer kans op rate limits en timeouts.
# RADIO_RESEARCH_CONCURRENCY=3

# ── Optionele connectors (nog niet geïmplementeerd) ───────────────────────
# De kern werkt volledig zonder betaalde databronnen. Deze variabelen horen bij
# de adapters die later aangesloten kunnen worden — zie
# lib/radio/research/connectors.ts voor het contract en de statuspagina.
# RADIO_SEARCH_PROVIDER=          # brave | serper | bing
# RADIO_SEARCH_API_KEY=           # nieuwsberichten → triggers met datum
# RADIO_KVK_API_KEY=              # vestigingen, SBI-code, actief ja/nee
# RADIO_JOBS_API_KEY=             # vacaturefeed → recruitment-signaal als feit
# RADIO_ENRICHMENT_API_KEY=       # contactpersonen (betaald, niet nodig voor de kern)
